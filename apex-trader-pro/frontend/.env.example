# Firebase web config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: absolute API origin. Leave empty when Firebase Hosting rewrites route to Cloud Run.
VITE_API_BASE=
# Local development only: skip Firebase login (backend must run with APEX_AUTH_DISABLED=true)
VITE_AUTH_DISABLED=false
