{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/get-balance", "run": { "serviceId": "get-balance", "region": "__REGION__" } },
      { "source": "/save-settings", "run": { "serviceId": "save-settings", "region": "__REGION__" } },
      { "source": "/get-settings", "run": { "serviceId": "get-settings", "region": "__REGION__" } },
      { "source": "/parse-custom-strategy", "run": { "serviceId": "parse-custom-strategy", "region": "__REGION__" } },
      { "source": "/api/**", "run": { "serviceId": "dashboard-api", "region": "__REGION__" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
